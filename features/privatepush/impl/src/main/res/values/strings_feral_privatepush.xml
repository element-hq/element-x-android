  <string name="feral_privatepush_configure_title">"Point ntfy to the Feral server"</string>
  <string name="feral_privatepush_configure_subtitle">"By default ntfy uses a public server. Tell it to use the Feral server instead."</string>
  <string name="feral_privatepush_configure_address_label">"Feral server address"</string>
  <string name="feral_privatepush_configure_copy">"Copy address"</string>
  <string name="feral_privatepush_configure_copied">"Address copied"</string>
  <string name="feral_privatepush_configure_hint_wrong_server_retry">"The Feral server could not be reached through ntfy. Check the Default server in ntfy, then try again."</string>
  <string name="feral_privatepush_configure_step_1">"Open ntfy."</string>
  <string name="feral_privatepush_configure_step_2">"Tap the menu (⋮) in the top-right corner, then Settings."</string>
  <string name="feral_privatepush_configure_step_3">"Under General, tap Default server."</string>
  <string name="feral_privatepush_configure_step_4">"Paste the Feral server address and confirm."</string>
  <string name="feral_privatepush_configure_step_5">"Come back to Feral."</string>
