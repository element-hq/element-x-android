  <string name="feral_privatepush_why_title">"Private notifications"</string>
  <string name="feral_privatepush_why_subtitle">"Feral does not use any Google service. Here is how your notifications reach you."</string>
  <string name="feral_privatepush_why_point_1">"Notifications travel through the Feral server, never through Google or Apple."</string>
  <string name="feral_privatepush_why_point_2">"A small helper app called ntfy keeps the connection to the Feral server open, so you are notified even when Feral is closed."</string>
  <string name="feral_privatepush_why_point_3">"This is a one-time setup and takes about two minutes."</string>
  <string name="feral_privatepush_why_privacy">"Notifications never contain your messages: only a signal that something new is waiting for you."</string>

  <string name="feral_privatepush_install_title">"Install the ntfy app"</string>
  <string name="feral_privatepush_install_subtitle">"ntfy is free and open source. Install it from wherever you prefer, then come back to Feral."</string>
  <string name="feral_privatepush_install_play">"Install from the Play Store"</string>
