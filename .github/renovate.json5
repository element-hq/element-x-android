{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
  ],
  "labels": [
    "PR-Dependencies",
  ],
  "ignoreDeps": [
    "gradle",
  ],
  "minimumReleaseAge": "7 days",
  "hostRules": [
    {
      "matchHost": "https://repo1.maven.org/maven2/",
      "concurrentRequestLimit": 10,
      "maxRequestsPerSecond": 10,
      "timeout": 10000,
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "org.matrix.rustcomponents:sdk-android",
        "/^io.element.android/",
      ],
      "minimumReleaseAge": null,
      // Max default value is 6, with this we give absolute priority to our own dependencies
      "prPriority": 7,
      "registryUrls": [ "https://repo1.maven.org/maven2/" ],
    },
    {
      // Fetch Android dependencies from Google's Maven repo instead of Maven Central.
      "matchPackageNames": [
        "/^androidx\\./",
        "/^android\\./",
        "/^com\\.android\\.tools/",
        "/^com\\.google\\.firebase/",
        "/^com\\.google\\.android/",
      ],
      "registryUrls": [ "https://dl.google.com/android/maven2/" ],
    },
    {
      "groupName": "kotlin",
      "matchPackageNames": [
        "/^org.jetbrains.kotlin/",
        "/^com.google.devtools.ksp/",
        "/^androidx.compose.compiler/",
      ],
    },
    {
      "versioning": "semver",
      "matchPackageNames": [
        "/^org.maplibre/",
        "/^org.jetbrains.kotlinx:kotlinx-datetime/",
      ],
    },
    {
      // Keep Guava on the Android variant and ignore jre-only upgrades.
      "matchPackageNames": [
        "com.google.guava:guava",
      ],
      "allowedVersions": "/-android$/",
    },
    {
      // Limit PostHog Android upgrade to one PR per month, the first day of the month
      "matchPackageNames": [
        "com.posthog:posthog-android",
      ],
      "schedule": [
          "* * 1 * *",
      ]
    },
  ],
}
